{
  "rules": {
    "kk_queue": {
      ".read": true,
      "$pid": {
        ".write": true,
        ".validate": "newData.hasChildren(['ts']) && newData.child('ts').isNumber()"
      }
    },
    "kk_rooms": {
      ".read": true,
      "$rid": {
        ".write": true
      }
    },
    "kk_lb": {
      ".read": true,
      "$mode": {
        "$pid": {
          ".write": true,
          ".validate": "newData.hasChildren(['score']) || newData.hasChildren(['nick'])"
        }
      }
    },
    "kk_testers": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
